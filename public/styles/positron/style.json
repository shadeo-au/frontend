      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 11,
      "filter": ["==", ["get", "class"], "residential"],
      "paint": {
        "fill-color": "rgb(238, 238, 234)",
        "fill-opacity": [
          "interpolate", ["linear"], ["zoom"],
          11, 0.3,
          14, 0.7
        ]
      }
    },
    {
      "id": "landuse-commercial",
      "type": "fill",
      "source": "openmaptiles",
