# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored so secrets stay off the repo.

# SHA-256 hash of the access password. The local preview password is "shadeo".
# To generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
VITE_GATE_HASH=b081e2106dd9f6cefff652ee27d61b8975b505f66e927aa558da20c0aa8adf33

# Shadeo AI weather suitability API used by the Walk Planner readiness check.
# Leave this as the deployed endpoint, or point it at a local Flask API while developing.
VITE_WEATHER_SUITABILITY_ENDPOINT=https://d22z6whz3d.execute-api.ap-southeast-2.amazonaws.com/api/weather-suitability

# Optional default for the readiness weather selector: "today" or "tomorrow".
VITE_DEFAULT_TRIP_DATE=today

# Optional: show a Melbourne CBD demo start button outside local dev.
VITE_ENABLE_DEMO_START=false

# Optional: use a local demo route if the live route service is unavailable.
VITE_ENABLE_DEMO_ROUTE_FALLBACK=false
